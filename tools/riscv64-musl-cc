#!/bin/sh
# zig cc wrapper for riscv64-linux-musl cross builds.
# nginx configure compiles feature-test programs to objs/autotest and then RUNS them;
# a cross-compiled riscv64 ELF cannot execute on the build host, so after a successful
# autotest compile we replace the output with a shell script that answers the tests.
# The answers are derived from the still-present autotest.c, so they are accurate for
# riscv64 lp64d. No nginx source file is modified.
out=""
prev=""
for a in "$@"; do
    if [ "$prev" = "-o" ]; then out="$a"; fi
    prev="$a"
done
zig cc -target riscv64-linux-musl "$@"
rc=$?
if [ $rc -eq 0 ] && printf '%s' "$out" | grep -q autotest; then
    cat > "$out" <<'EOF'
#!/bin/sh
c="$(dirname "$0")/autotest.c"
if [ -f "$c" ] && grep -q 'sizeof' "$c" 2>/dev/null; then
    t=$(grep -o 'sizeof([^)]*)' "$c" | head -1)
    if [ "$t" = "sizeof(int)" ]; then
        echo 4
    else
        echo 8
    fi
else
    echo 4096
fi
exit 0
EOF
    chmod +x "$out"
fi
exit $rc
